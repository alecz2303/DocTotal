APP_NAME=DocTotal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Producción debe usar como mínimo:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio-productivo
#
# Antes de habilitar tráfico, scheduler o workers en producción ejecutar:
# php artisan doctotal:check-production-readiness --probe
# php artisan doctotal:check-data-durability
#
# Si existe reverse proxy o terminación TLS, debe preservar el Host canónico
# y HTTPS de forma confiable. No confiar proxies arbitrarios desde la app.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Producción: LOG_LEVEL=info (o un nivel más restrictivo)

DB_CONNECTION=sqlite
# Producción debe usar MySQL/MariaDB según la infraestructura objetivo.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=doctotal
# DB_USERNAME=doctotal
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Producción: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Producción debe conservar failed jobs; no usar QUEUE_FAILED_DRIVER=null.
# QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Producción debe usar un transport real y una dirección real del servicio.

BILLING_PAYMENT_GATEWAY=fake
BILLING_AUTOMATIC_CHARGING_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Producción requiere BILLING_PAYMENT_GATEWAY=stripe y las tres credenciales Stripe.
# BILLING_AUTOMATIC_CHARGING_ENABLED solo debe activarse de forma controlada.

# Durabilidad de datos en producción. El proveedor/mecanismo real de backup
# se configura en infraestructura; DocTotal valida que la estrategia declarada
# cubra base de datos, archivos privados y restauración verificable.
DOCTOTAL_BACKUP_ENABLED=false
DOCTOTAL_BACKUP_DATABASE=false
DOCTOTAL_BACKUP_PRIVATE_FILES=false
DOCTOTAL_BACKUP_PROVIDER=
DOCTOTAL_BACKUP_FREQUENCY_HOURS=24
DOCTOTAL_BACKUP_RETENTION_COPIES=7
DOCTOTAL_RESTORE_RUNBOOK=docs/OPERATIONS_DATA_DURABILITY.md
DOCTOTAL_RESTORE_VERIFICATION_REQUIRED=true
DOCTOTAL_RETENTION_MODE=manual
DOCTOTAL_RETENTION_AUTOMATIC_DELETION_ENABLED=false
# En producción, habilitar backups solo después de configurar el mecanismo real.
# Mantener el borrado automático en false mientras no exista política aprobada.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
